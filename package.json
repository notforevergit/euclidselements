{
  "name": "straightedge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "description": "A straightedge-and-compass construction game built on Euclid's Elements, Book I.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "npm run test:watch --workspace=@straightedge/geometry",
    "e2e": "npm run e2e --workspace=@straightedge/web",
    "verify": "turbo run typecheck lint test build"
  },
  "devDependencies": {
    "turbo": "^2.10.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
